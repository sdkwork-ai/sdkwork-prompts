# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_PROMPTS_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROMPTS_ENVIRONMENT=staging
SDKWORK_PROMPTS_PROFILE_ID=cloud.staging
